# MeasureOne connection settings (Pass 108). Copy this file to .env.local
# (never committed) and fill in both values from the Supabase dashboard:
# Project Settings > API (or Data API). See DEPLOYMENT.md.
#
# Local development uses the TEST project. Leave both empty, or skip
# .env.local entirely, and the app runs exactly as it did before accounts:
# no sign-in, everything saved to this browser only.
#
# Use the public key only ("anon", or "publishable": starts sb_publishable_).
# NEVER the secret / service_role key: it bypasses the database's security rules.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The bot check's PUBLIC site key (Pass 135, Cloudflare Turnstile). Optional: leave it
# empty and the app never loads the bot check and never offers "Create an account"
# (it behaves exactly as it did before open sign-up). See DEPLOYMENT.md, "Open sign-up".
#
# Local development and Preview use Cloudflare's published TEST site key, which works
# on any address and always passes:  1x00000000000000000000AA
# Production uses the real site key from the Cloudflare dashboard (Turnstile, your widget).
#
# The site key is public (it is in what every visitor downloads). The bot check's
# SECRET key is NOT: it is typed only into Supabase's dashboard and must never be put
# here, in Vercel, or anywhere in this repository.
VITE_TURNSTILE_SITE_KEY=
