# MeasureOne connection settings (Pass 108). Copy this file to .env.local
# (never committed) and fill in both values from the Supabase dashboard:
# Project Settings > API (or Data API). See DEPLOYMENT.md.
#
# Local development uses the TEST project. Leave both empty, or skip
# .env.local entirely, and the app runs exactly as it did before accounts:
# no sign-in, everything saved to this browser only.
#
# Use the public key only ("anon", or "publishable": starts sb_publishable_).
# NEVER the secret / service_role key: it bypasses the database's security rules.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
